<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // Coordinates for Bondi Beach
    const bondiBeach = [-33.8915, 151.2767];

    // Create the map
    const map = L.map('map').setView(bondiBeach, 15);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // Add a marker
    L.marker(bondiBeach)
      .addTo(map)
      .bindPopup('<strong>Bondi Beach</strong><br>Sydney, Australia')
      .openPopup();
  </script>

</body>
</html>
